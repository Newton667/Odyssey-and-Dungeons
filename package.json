{
  "name": "ond-odyssey-and-dragons",
  "version": "0.2.0",
  "description": "OND - Your local D&D companion app",
  "main": "electron/main.js",
  "author": "Newton667",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"cd server && node server.js\" \"cd client && npx vite\"",
    "build:client": "cd client && npx vite build",
    "electron": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder",
    "postinstall": "cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ond.dnd",
    "productName": "OND - Odyssey and Dragons",
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "!**/node_modules/.cache",
      "!**/.git"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*", "!node_modules/.cache/**"]
      },
      {
        "from": "client",
        "to": "client",
        "filter": ["dist/**/*", "src/data/**/*"]
      }
    ],
    "win": {
      "target": "dir"
    }
  }
}
